{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job Search Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "source_commit",
    "search_criteria",
    "discovered_count",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "search_criteria": {
      "type": "string",
      "minLength": 1
    },
    "discovered_count": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_count": {
      "type": "integer",
      "minimum": 0
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "job_id",
          "requirement",
          "assumption"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "assumption": {
            "type": "string"
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "company",
          "title",
          "posting_url",
          "status",
          "decision",
          "fit_percent",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "posting_url": {
            "type": "string"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "compensation": {
            "type": [
              "string",
              "null"
            ]
          },
          "company_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "role_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "eligible",
              "excluded",
              "needs_verification",
              "evaluation_error",
              "deprioritized"
            ],
            "description": "deprioritized: stopped at the L2 knockout screen."
          },
          "decision": {
            "enum": [
              "undecided",
              "pass",
              "interested"
            ]
          },
          "fit_percent": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          },
          "strongest_evidence": {
            "type": [
              "string",
              "null"
            ],
            "description": "Plain words, no record IDs; required on schema 1.3 review cards."
          },
          "primary_gap": {
            "type": [
              "string",
              "null"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tag",
                "quote",
                "kind",
                "score",
                "record_ids"
              ],
              "properties": {
                "tag": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "do",
                    "want",
                    "nice",
                    "role",
                    "about",
                    "trait",
                    "condition"
                  ]
                },
                "score": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 4
                },
                "record_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "condition_status": {
                  "enum": [
                    "pass",
                    "fail",
                    "unknown"
                  ]
                },
                "competency_id": {
                  "type": "string"
                },
                "mandatory": {
                  "type": "boolean"
                },
                "qualification_status": {
                  "enum": [
                    "supported",
                    "unresolved",
                    "unmet"
                  ]
                },
                "evidence_note": {
                  "type": "string"
                },
                "evidence_alignment": {
                  "enum": [
                    "direct",
                    "transferable",
                    "adjacent",
                    "none"
                  ]
                },
                "result_quality": {
                  "enum": [
                    "established",
                    "unclear",
                    "none"
                  ]
                },
                "quote_status": {
                  "enum": [
                    "unverified",
                    "source_verified"
                  ],
                  "description": "Absent means unverified. source_verified requires source and is checked by pipeline.py validate --artifacts."
                },
                "source": {
                  "type": "object",
                  "description": "Canonical-source reference inside a guarded jd_key selection.",
                  "required": [
                    "tag",
                    "source",
                    "quote_sha256"
                  ],
                  "properties": {
                    "tag": {
                      "type": "string"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "Half-open code-point offsets into the canonical source, inside the selection's span."
                    },
                    "quote_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "defining": {
                  "type": "boolean",
                  "description": "The posting labels this ask most important, must-have, required by name or defining. Must be mandatory."
                },
                "threshold_note": {
                  "type": "string",
                  "description": "Why a mandatory ask scored 3+ stays unresolved (an unsettled threshold such as years or funding stage)."
                },
                "contradiction": {
                  "type": "string",
                  "description": "The dated record and computation that contradict an unmet mandatory ask."
                },
                "mandatory_basis": {
                  "enum": [
                    "explicit",
                    "inferred"
                  ],
                  "description": "Current mandatory asks require explicit; responsibilities cannot be mandatory."
                },
                "source_tags": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "exclusion": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "requirement_quote": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "basis": {
                "enum": [
                  "explicit_condition"
                ]
              }
            },
            "required": [
              "requirement_quote",
              "reason",
              "basis"
            ]
          },
          "eligibility": {
            "enum": [
              "pass",
              "unresolved",
              "fail",
              null
            ]
          },
          "application_confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              null
            ]
          },
          "confidence_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "functional_fit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "jd_artifact": {
            "type": [
              "object",
              "null"
            ],
            "description": "Reference to a B5 JD artifact stored at <artifacts dir>/<artifact_id>/ (job-search/schemas/jd-artifact.schema.json). Required when any requirement is source_verified.",
            "required": [
              "artifact_id",
              "canonical_sha256"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^jd-[0-9a-f]{16}-[0-9a-f]{8}$"
              },
              "canonical_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "screen": {
            "type": [
              "object",
              "null"
            ],
            "description": "L2 knockout result. Required for every job that is not excluded or an evaluation error; the validator recomputes it.",
            "required": [
              "critical_gaps",
              "routing"
            ],
            "properties": {
              "critical_gaps": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "competency_ids of mandatory asks scored 0-1 or unmet"
              },
              "routing": {
                "enum": [
                  "full_score",
                  "full_score_flagged",
                  "deprioritized"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "One line; required when deprioritized"
              }
            }
          },
          "posted_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d\\d-\\d\\d$",
            "description": "Schema 1.3 (required): the provider's posted date, or null."
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d\\d-\\d\\d$",
            "description": "Schema 1.3: an application deadline stated in the posting. A deadline before run_date makes the job an evaluation_error."
          },
          "workplace": {
            "type": [
              "string",
              "null"
            ],
            "description": "Remote, Hybrid or Onsite as the provider states it."
          },
          "error_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Schema 1.3: why an evaluation_error job was not scored."
          },
          "card": {
            "type": "object",
            "description": "Schema 1.3, required on eligible and needs_verification jobs. Describes the job from the posting; leave out fields the posting does not state.",
            "required": [
              "business",
              "owns",
              "responsibilities"
            ],
            "properties": {
              "business": {
                "type": "string",
                "minLength": 1,
                "description": "What the company sells and to whom."
              },
              "industry": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "string",
                "minLength": 1,
                "description": "Funding stage, headcount or public/private."
              },
              "owns": {
                "type": "string",
                "minLength": 1,
                "description": "What this person would own."
              },
              "level": {
                "type": "string",
                "minLength": 1
              },
              "reports_to": {
                "type": "string",
                "minLength": 1
              },
              "team": {
                "type": "string",
                "minLength": 1
              },
              "responsibilities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Quoted from the posting."
              }
            },
            "additionalProperties": false
          },
          "l1": {
            "type": "object",
            "required": [
              "l1",
              "reasons"
            ],
            "properties": {
              "l1": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown",
                  "evaluation_error"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "provider_compensation": {
            "type": [
              "object",
              "null"
            ],
            "description": "Original structured amount, currency and frequency; unsupported conversions remain unknown."
          },
          "inferred_concerns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Unscored interpretations; cannot create mandatory qualification knockouts."
          },
          "evaluation_policy": {
            "const": "shared-2",
            "description": "Fit, label and requirements met come from tools/evaluation.py."
          },
          "baseline_fit": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "adjustment": {
            "type": "number",
            "minimum": -5,
            "maximum": 5
          },
          "adjustment_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage": {
            "type": "object",
            "required": [
              "map_sha256"
            ],
            "properties": {
              "map_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "deferred": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "label": {
            "enum": [
              "Promising",
              "Stretch",
              "Deprioritize",
              null
            ],
            "description": "shared-2: the shared label from tools/evaluation.py; null only for an evaluation error."
          },
          "requirements_met": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "met": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            },
            "description": "Required (Want-tagged) competencies scored 3-4, of all required competencies."
          },
          "stale_posting": {
            "type": "boolean",
            "description": "Posted more than the criteria's stale_after_days before the run date."
          }
        }
      }
    },
    "run_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$",
      "description": "Schema 1.3: the day the run was screened; posting age and deadlines are measured against it."
    },
    "completion": {
      "type": "object",
      "description": "Written by pipeline.py assemble from pipeline.py status: complete, partial or failed, with the problems. The agent never sets it.",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "jobs": {
          "type": "integer"
        },
        "valid_results": {
          "type": "integer"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workflow_version": {
      "type": "integer",
      "enum": [
        2
      ],
      "description": "Current runs pin L1 rules; older runs may omit this field."
    },
    "l1_rules": {
      "type": "object",
      "required": [
        "conditions",
        "max_age_days",
        "min_pay"
      ],
      "properties": {
        "conditions": {
          "type": "object"
        },
        "max_age_days": {
          "type": [
            "integer",
            "null"
          ]
        },
        "min_pay": {
          "type": [
            "number",
            "null"
          ]
        },
        "stale_after_days": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "evaluation_policy": {
      "const": "shared-2",
      "description": "Pinned by the current CLI (freeze); fixtures without it are structural tests."
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "workflow_version"
        ],
        "properties": {
          "workflow_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "l1_rules"
        ],
        "properties": {
          "jobs": {
            "items": {
              "required": [
                "l1"
              ],
              "properties": {
                "requirements": {
                  "items": {
                    "if": {
                      "required": [
                        "mandatory"
                      ],
                      "properties": {
                        "mandatory": {
                          "const": true
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "mandatory_basis"
                      ],
                      "properties": {
                        "mandatory_basis": {
                          "const": "explicit"
                        },
                        "kind": {
                          "not": {
                            "const": "do"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "evaluation_policy"
        ],
        "properties": {
          "evaluation_policy": {
            "const": "shared-2"
          }
        }
      },
      "then": {
        "properties": {
          "jobs": {
            "items": {
              "required": [
                "evaluation_policy",
                "baseline_fit",
                "adjustment",
                "adjustment_reason",
                "label",
                "requirements_met"
              ],
              "properties": {
                "evaluation_policy": {
                  "const": "shared-2"
                }
              }
            }
          }
        }
      }
    }
  ]
}
